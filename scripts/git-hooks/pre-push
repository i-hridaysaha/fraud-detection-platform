#!/usr/bin/env bash
# Refuses a direct push to main. main takes changes through a pull request with green CI.
# Runs the full test suite before any push of commits, so nothing reaches the remote without
# passing tests locally. The suite used to run on every commit from pre-commit; it moved here
# so that granular commits stay cheap while every push and every merge still gates on tests.
# Installed by `make setup`. GitHub-side protection is not available on a private repo under the
# current plan, so this hook is the enforcement until the repo goes public.
set -euo pipefail

zero_sha="0000000000000000000000000000000000000000"
run_tests=0

while read -r _local_ref local_sha remote_ref _remote_sha; do
    if [ "$remote_ref" = "refs/heads/main" ]; then
        echo "pre-push: direct push to main refused. open a pull request instead."
        exit 1
    fi
    # a branch deletion pushes the zero sha; there is nothing to test
    if [ "$local_sha" != "$zero_sha" ]; then
        run_tests=1
    fi
done

if [ "$run_tests" -eq 1 ]; then
    echo "pre-push: running the full test suite"
    .venv/bin/pytest -q
fi

exit 0
